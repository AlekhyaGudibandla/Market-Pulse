# MarketPulse Environment Configuration
PROJECT_NAME="MarketPulse"
ENVIRONMENT="development"
DEBUG=true

# Graph Database (Neo4j)
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="marketpulse_secret"
USE_EMBEDDED_GRAPH=true

# Event Streaming (Kafka KRaft)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
USE_EMBEDDED_KAFKA=true

# Transactional & Vector DB
DATABASE_URL="postgresql://marketpulse:marketpulse@localhost:5432/marketpulse_db"
VECTOR_DIMENSION=384

# Caching & Deduplication
REDIS_URL="redis://localhost:6379/0"
USE_EMBEDDED_CACHE=true

# Thresholds
NOVELTY_THRESHOLD_ALERT=0.65
IMPACT_THRESHOLD_HIGH=0.70
ENTITY_RESOLUTION_CONFIDENCE_THRESHOLD=0.78
